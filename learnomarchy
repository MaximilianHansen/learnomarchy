declare -a LEVEL_NAMES=('' TAKEOFF RADAR CARGO FORMATION STASH AFTERBURNER GHOST SQUADRON PSYCHOPATH)
declare -a LEVEL_PARS=('' 1500 1300 2200 1600 1500 1700 1900 1700 1800)
N_LEVELS=9

# ---------------------------------------------------------------- progress
load_progress() {
  [[ -f $SAVE_FILE ]] || return 0
  local n s b
  while IFS='|' read -r n s b; do
    [[ $n =~ ^[0-9]+$ ]] && { STARS[$n]=$s; BEST[$n]=$b; }
  done < "$SAVE_FILE"
}
save_progress() {
  mkdir -p "$SAVE_DIR"
  local n
  for n in "${!STARS[@]}"; do
    echo "$n|${STARS[$n]}|${BEST[$n]:-0}"
  done > "$SAVE_FILE"
}
unlocked() { (( $1 == 1 )) || (( ${STARS[$(( $1 - 1 ))]:-0} >= 3 )); }
total_stars() {
  local t=0 n
  for n in "${!STARS[@]}"; do (( t += ${STARS[$n]} )); done
  echo "$t"
}

# ---------------------------------------------------------------- menu
menu_screen() {
  local key n line tier
  while :; do
    begin_frame
    row ''
    row "${B}${CYN}✈  L E A R N O M A R C H Y${R}"
    row "${D}learn to fly omarchy${R}"
    row ''
    for n in $(seq 1 "$N_LEVELS"); do
      case $n in
        1) row "${D}── CADET ──────────────${R}";;
        4) row "${D}── PILOT ──────────────${R}";;
        7) row "${D}── ACE ────────────────${R}";;
      esac
      if unlocked "$n"; then
        local s=${STARS[$n]:-0} sr='' i
        for i in 1 2 3 4 5; do
          (( i <= s )) && sr+="${YEL}★${R}" || sr+="${D}☆${R}"
        done
        line=$(printf '%s%d %-12s%s %s' "$B" "$n" "${LEVEL_NAMES[$n]}" "$R" "$sr")
        [[ -n ${BEST[$n]:-} ]] && line+="  ${D}$(fmt_cs "${BEST[$n]}")s${R}"
        row "$line"
      else
        row "${D}$(printf '%d %-12s' "$n" "${LEVEL_NAMES[$n]}") 🔒 3★ level $(( n - 1 ))${R}"
      fi
    done
    row ''
    local ts; ts=$(total_stars)
    if (( ts >= 45 )); then
      row "${B}${YEL}★ $ts/45 — PSYCHOPATH CERTIFIED ★${R}"
    else
      row "${D}★ $ts/45${R}"
    fi
    row ''
    row "${D}[1-9] fly   [q] quit${R}"
    flush_frame
    read -rsn1 key 2>/dev/null
    case $key in
      [1-9]) unlocked "$key" && { CHOICE=$key; return 0; };;
      q) return 1;;
    esac
  done
}

# ---------------------------------------------------------------- window setup
setup_window() {
  [[ -n $HERE ]] && return  # debugging in an existing terminal: leave it alone
  printf '\e]2;learnomarchy #%s\a' "$$"
  local i
  for i in {1..60}; do
    SELF_ADDR=$(hyprctl clients -j 2>/dev/null | jq -r --arg t "learnomarchy #$$" \
      '.[] | select(.title == $t) | .address')
    [[ -n $SELF_ADDR ]] && break
    sleep 0.05
  done
  [[ -z $SELF_ADDR ]] && return
  read_monitor
  local w=920 h=560 win="address:$SELF_ADDR"
  local x=$(( MON_X + MON_W - w - 24 )) y=$(( MON_Y + 60 ))
  hd "hl.dsp.window.float({ window = \"$win\", action = \"toggle\" })" setfloating "$win"
  hd "hl.dsp.window.resize({ window = \"$win\", x = $w, y = $h })" \
     resizewindowpixel "exact $w $h,$win"
  hd "hl.dsp.window.move({ window = \"$win\", x = $x, y = $y })" \
     movewindowpixel "exact $x $y,$win"
  hd "hl.dsp.window.pin({ window = \"$win\" })" pin "$win"
  hd "hl.dsp.window.alter_zorder({ window = \"$win\", mode = \"top\" })" alterzorder "top,$win"
  hd "hl.dsp.focus({ window = \"$win\" })" focuswindow "$win"
}

# ---------------------------------------------------------------- main
finish() {
  cleanup_targets
  printf '\e[?1049l\e[?25h'
}
trap finish EXIT
trap 'exit 130' INT TERM

printf '\e[?1049h\e[?25l'
setup_window
load_progress

CHOICE=${1:-}
[[ $CHOICE == --level ]] && CHOICE=${2:-1}
[[ $CHOICE =~ ^[1-9]$ ]] || CHOICE=''

while :; do
  if [[ -z $CHOICE ]]; then
    menu_screen || break
    CHOICE=$CHOICE
  fi
  ACTION=menu
  "level_$CHOICE"
  case $ACTION in
    retry) ;;                              # same CHOICE, go again
    next)  if (( CHOICE < N_LEVELS )) && unlocked $(( CHOICE + 1 )); then
             CHOICE=$(( CHOICE + 1 ))
           else CHOICE=''; fi;;
    menu)  CHOICE='';;
    quit)  break;;
  esac
done
